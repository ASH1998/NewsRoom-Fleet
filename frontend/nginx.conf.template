server {
    listen       ${PORT};
    server_name  _;

    root  /usr/share/nginx/html;
    index index.html;

    # Single-page app: unknown paths render the editor desk, not a 404.
    location / {
        try_files $uri $uri/ /index.html;
    }

    # Same-origin proxy to the backend Cloud Run service.
    location /api/ {
        proxy_pass         ${BACKEND_URL};
        proxy_http_version 1.1;
        proxy_set_header   Host              $proxy_host;
        proxy_set_header   X-Forwarded-Proto $scheme;
        proxy_set_header   X-Forwarded-For   $proxy_add_x_forwarded_for;

        # A live review fans several Gemini calls out per claim; the default
        # 60s read timeout would cut a legitimate submission short.
        proxy_read_timeout 300s;
        proxy_send_timeout 300s;
    }
}
